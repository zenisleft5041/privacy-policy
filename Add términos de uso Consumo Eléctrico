<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Términos de Uso — Consumo Eléctrico</title>
  <style>
    :root {
      --bg:      #0B0F14;
      --bg2:     #0F172A;
      --surface: #1E293B;
      --accent:  #38BDF8;
      --text:    #F8FAFC;
      --muted:   #94A3B8;
      --border:  #1E293B;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      font-size: 16px;
      line-height: 1.7;
      padding: 0 16px;
    }

    .container {
      max-width: 760px;
      margin: 0 auto;
      padding: 48px 0 80px;
    }

    /* Header */
    .header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 40px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .header-icon {
      width: 52px;
      height: 52px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      flex-shrink: 0;
    }

    h1 {
      font-size: 26px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.3px;
    }

    .app-name {
      font-size: 14px;
      color: var(--accent);
      font-weight: 500;
      margin-top: 2px;
    }

    /* Metadata */
    .meta {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 36px;
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .meta-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--muted);
      font-weight: 600;
    }

    .meta-value {
      font-size: 14px;
      color: var(--text);
      font-weight: 500;
    }

    /* Sections */
    .section {
      margin-bottom: 40px;
    }

    h2 {
      font-size: 18px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    h2::before {
      content: '';
      display: inline-block;
      width: 4px;
      height: 18px;
      background: var(--accent);
      border-radius: 2px;
      flex-shrink: 0;
    }

    p {
      color: var(--muted);
      margin-bottom: 12px;
      font-size: 15px;
    }

    ul, ol {
      padding-left: 20px;
      margin-bottom: 12px;
    }

    li {
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 6px;
    }

    strong {
      color: var(--text);
      font-weight: 600;
    }

    /* Info box */
    .info-box {
      background: color-mix(in srgb, var(--accent) 10%, var(--bg2));
      border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
      border-radius: 8px;
      padding: 14px 16px;
      margin: 16px 0;
    }

    .info-box p {
      margin: 0;
      color: color-mix(in srgb, var(--accent) 80%, var(--text));
      font-size: 14px;
    }

    /* Divider */
    hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 32px 0;
    }

    /* Footer */
    .footer {
      text-align: center;
      padding-top: 32px;
      border-top: 1px solid var(--border);
    }

    .footer-brand {
      color: var(--accent);
      font-weight: 700;
      font-size: 16px;
    }

    .footer-meta {
      color: var(--muted);
      font-size: 13px;
      margin-top: 4px;
    }

    .footer a {
      color: var(--accent);
      text-decoration: none;
    }

    a {
      color: var(--accent);
    }

    /* Responsive */
    @media (prefers-color-scheme: light) {
      :root {
        --bg:      #F8FAFC;
        --bg2:     #F1F5F9;
        --surface: #E2E8F0;
        --text:    #1E293B;
        --muted:   #475569;
        --border:  #E2E8F0;
      }
    }

    @media (max-width: 600px) {
      h1 { font-size: 22px; }
      h2 { font-size: 16px; }
    }
  </style>
</head>
<body>
  <div class="container">

    <!-- Header -->
    <div class="header">
      <div class="header-icon">⚡</div>
      <div>
        <h1>Términos de Uso</h1>
        <div class="app-name">Consumo Eléctrico · ZenisLab</div>
      </div>
    </div>

    <!-- Metadata -->
    <div class="meta">
      <div class="meta-item">
        <span class="meta-label">Última actualización</span>
        <span class="meta-value">Junio 2026</span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Versión de la app</span>
        <span class="meta-value">1.0.0 y posteriores</span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Plataforma</span>
        <span class="meta-value">Android</span>
